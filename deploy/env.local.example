# Home Mate — data/env.local template (values are secrets; this file is
# gitignored on every machine and NEVER committed with values filled in).
# The core loads it at startup (keys only enter the process environment;
# per-service keys can alternatively be set through the console Services page,
# which stores them in the SQLite secrets table write-only).
#
# LLM (e.g. DeepSeek / OpenAI / GLM):
GLM_API_KEY=

# TTS (Volcengine seed-tts-2.0):
VOLC_API_KEY=

# ASR (optional local/LAN OpenAI-compatible /v1/audio/transcriptions server):
# Point base_url at the LAN address if exposed on LAN;
# 127.0.0.1 works only when the ASR service runs on the same host.
# Console Services page asr: provider=openai-asr.
